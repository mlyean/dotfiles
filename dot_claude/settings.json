{
  "cleanupPeriodDays": 99999,
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ffplay -nodisp -autoexit -loglevel quiet -f lavfi -i \"sine=frequency=1760:duration=0.3\" >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "timeFormat": "12-hour",
  "theme": "custom:rose-pine",
  "editorMode": "vim",
  "autoCompactEnabled": true
}
